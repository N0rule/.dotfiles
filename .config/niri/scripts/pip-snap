#!/usr/bin/env python3
"""Snap Brave picture-in-picture to the bottom-right of its output."""
import argparse
import json
import re
import subprocess
import sys


def niri(*args):
    return subprocess.run(["niri", "msg", *args], capture_output=True,
                          text=True, check=True).stdout


def query(name):
    return json.loads(niri("--json", name))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("width", nargs="?", type=int, default=320)
    parser.add_argument("height", nargs="?", type=int)
    parser.add_argument("margin", nargs="?", type=int, default=24)
    args = parser.parse_args()
    width = args.width
    height = args.height if args.height is not None else round(width * 9 / 16)
    if width <= 0 or height <= 0 or args.margin < 0:
        parser.error("dimensions must be positive and margin nonnegative")
    outputs = query("outputs")
    workspaces = {w["id"]: w for w in query("workspaces")}
    for window in query("windows"):
        if window.get("app_id") != "brave-origin" or not re.fullmatch(
                r"picture[ -]in[ -]picture", window.get("title") or "", re.I):
            continue
        wid = str(window["id"])
        if not window.get("is_floating"):
            niri("action", "move-window-to-floating", "--id", wid)
        niri("action", "set-window-width", "--id", wid, str(width))
        niri("action", "set-window-height", "--id", wid, str(height))
        output = workspaces.get(window.get("workspace_id"), {}).get("output")
        logical = outputs.get(output, {}).get("logical")
        if not logical:
            continue
        x = max(0, logical["width"] - width - args.margin)
        y = max(0, logical["height"] - height - args.margin)
        req_x, req_y = x, y
        # Correct for reserved panel space without hardcoding the bar height.
        for _ in range(4):
            niri("action", "move-floating-window", "--id", wid,
                 "--x", str(round(req_x)), "--y", str(round(req_y)))
            current = next((w for w in query("windows") if w["id"] == window["id"]), {})
            pos = current.get("layout", {}).get("tile_pos_in_workspace_view")
            if pos is None:
                break
            dx, dy = pos[0] - x, pos[1] - y
            if abs(dx) < 1 and abs(dy) < 1:
                break
            req_x -= dx
            req_y -= dy
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, subprocess.CalledProcessError, ValueError) as error:
        print(f"pip-snap: {error}", file=sys.stderr)
        sys.exit(1)
