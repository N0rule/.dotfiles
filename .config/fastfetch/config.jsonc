{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "padding": { "top": 4, "left": 1, "right": 2 },
    "printRemaining": true,
    "color": {
      "1": "light_black",
      "2": "light_white"
    }
  },

  "display": {
    "separator": "  ",
    "key": { "width": 18 },
    "brightColor": true,
    "disableLinewrap": true
  },

  "modules": [
    "break",
    { "type": "colors", "key": " ", "paddingLeft": 4, "symbol": "circle" },

    "break",

    { "type": "os",       "key": "╭─ 󰣇  OS:",       "keyColor": "magenta" },
    { "type": "kernel",   "key": "├─ 󰌢  Kernel:",   "keyColor": "magenta", "format": "{release}" },
    { "type": "wm",       "key": "├─ 󰕮  WM:",       "keyColor": "magenta", "format": "{pretty-name}" },
    { "type": "theme",    "key": "├─ 󰟡  Theme:",    "keyColor": "magenta" },
    { "type": "icons",    "key": "├─ 󰀻  Icons:",    "keyColor": "magenta" },
    { "type": "terminal", "key": "├─ 󰆍  Terminal:", "keyColor": "magenta" },
    { "type": "terminalfont", "key": "├─ 󰛖  Font:", "keyColor": "magenta" },
    { "type": "shell",    "key": "├─ 󱆃  Shell:",    "keyColor": "magenta" },
    { "type": "packages", "key": "╰─ 󰏗  Packages:", "keyColor": "magenta" },

    "break",

    { "type": "host",     "key": "╭─ 󰟀  PC:",       "keyColor": "yellow" },
    { "type": "cpu",      "key": "├─ 󰻠  CPU:",      "keyColor": "yellow" },
    { "type": "gpu",      "key": "├─ 󰍛  GPU:",      "keyColor": "yellow" },
    {
      "type": "display",  "key": "├─ 󰍹  Display:",  "keyColor": "yellow",
      "format": "{width}x{height} @ {refresh-rate} Hz ({name})"
    },
    {
      "type": "disk",     "key": "├─ 󰋊  Storage:",  "keyColor": "yellow",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage}) [{filesystem}]"
    },
    { "type": "memory",   "key": "├─ 󰒋  Memory:",   "keyColor": "yellow" },
    { "type": "swap",     "key": "├─ 󰓡  Swap:",     "keyColor": "yellow" },
    {
      "type": "battery",  "key": "├─ 󰁹  Battery:",  "keyColor": "yellow",
      "format": "{4} [{5}]"
    },
    {
      "type": "localip",  "key": "╰─ 󰩟  Local IP:", "keyColor": "yellow",
      "showIpv4": true,   "showIpv6": false
    },

    "break",

    {
      "type": "disk",     "key": "╭─ 󰃭  OS Age:",   "keyColor": "green",
      "folders": "/",
      "format": "{days} days"
    },
    { "type": "uptime",   "key": "╰─ 󱑀  Uptime:",   "keyColor": "green" },

    "break",

    { "type": "colors", "key": " ", "paddingLeft": 4, "symbol": "circle" }
  ]
}
